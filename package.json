{
  "name": "@codefoxs/dsh-efforts-detector",
  "version": "1.1.1",
  "description": "Backfill reasoningEfforts on DSH pi-ai routes from the model listing each route publishes.",
  "type": "module",
  "license": "MIT",
  "author": "CodeFox",
  "homepage": "https://github.com/codefoxs/dsh-efforts-detector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefoxs/dsh-efforts-detector.git"
  },
  "bugs": {
    "url": "https://github.com/codefoxs/dsh-efforts-detector/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "llm"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
